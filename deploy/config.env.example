# Copy to deploy/config.env and edit. gcp-setup.sh sources this.
# Only these need your attention - everything else is derived or generated.

PROJECT_ID=madem-real-estate
REGION=europe-west3            # Frankfurt; pick the region closest to your users
REPO=madem                     # Artifact Registry repo name
SQL_INSTANCE=madem-pg
SQL_TIER=db-custom-1-3840      # ~$50/mo prod tier; db-f1-micro (~$9/mo) for staging
DB_NAME=madem_crm
DB_USER=madem

# Backend always-on instances. 1 = keeps the in-process reminder cron alive (~$10/mo
# extra). 0 = scale to zero (near-free, but the daily reminder scan won't fire).
MIN_INSTANCES=1

ADMIN_EMAIL=admin@madem.com
ADMIN_NAME="MADEM Admin"

# Public site URL baked into the CRM "share" links and used for CORS.
# Leave as the Cloud Run URL for the first deploy; set to your real domain later
# (then re-run - it rebuilds the CRM and updates CORS).
PUBLIC_SITE_URL=
